# Copy to usage-dashboard.env and fill in. usage-dashboard.env is gitignored.
# Docker Compose reads interpolation values (HOST_PORT, BIND_ADDRESS,
# CLAUDE_PROJECTS_DIR) from .env, so symlink it: ln -s usage-dashboard.env .env

# --- host/compose settings ---
# Host interface the port is published on. 0.0.0.0 exposes it to the LAN.
BIND_ADDRESS=127.0.0.1
HOST_PORT=8787
# Host path to Claude Code transcripts (mounted read-only).
CLAUDE_PROJECTS_DIR=/path/to/home/.claude/projects

# --- app settings ---
# IANA time zone for daily/monthly buckets and the today / 7-day windows.
# Falls back to TZ, then America/Detroit.
DASHBOARD_TIME_ZONE=America/Detroit

# Extra Host names allowed to reach the dashboard (comma-separated). localhost,
# 127.0.0.1 and [::1] are always allowed on PORT/HOST_PORT. An entry without a
# port is allowed on those ports; an entry with a port matches only that port.
# Use host, host:port, [ipv6] or [ipv6]:port (no scheme or path); a malformed
# entry stops startup. Behind a TLS proxy on 443 list it as host:443.
# Needed when you use BIND_ADDRESS=0.0.0.0 or a reverse proxy, e.g.:
# ALLOWED_HOSTS=dashboard.lan,192.168.1.20
ALLOWED_HOSTS=

# Optional: Anthropic Admin API key (sk-ant-admin01-...) for real org usage/cost.
ANTHROPIC_ADMIN_KEY=

# --- web search backends ---
# Which backend OpenClaw's web_search currently uses (mirror of the OpenClaw
# config key tools.web.search.provider): brave | searxng. Marks that tile "active".
# Leave empty to infer the badge from the latest recorded web_search call; then
# BRAVE_QUOTA_PROBE=auto never probes on its own.
WEB_SEARCH_PROVIDER=searxng
# Optional cutover history, used only for web_search calls whose tool result
# does not record a provider (errors, interrupted sessions). Comma-separated
# provider@ISO-8601 entries; earlier calls default to brave.
# WEB_SEARCH_PROVIDER_HISTORY=searxng@2026-11-17T21:00:00Z
WEB_SEARCH_PROVIDER_HISTORY=

# SearXNG base URL for the health check. Compose defaults it to
# http://host.docker.internal:8888 (the host's instance); outside Docker use
# http://127.0.0.1:8888.
SEARXNG_BASE_URL=http://host.docker.internal:8888
SEARXNG_TIMEOUT_SECONDS=5

# Brave Search API key, used only for the quota-header probe (1 query per probe).
BRAVE_API_KEY=your-brave-api-key
# USD per 1,000 requests and monthly free credit (Brave pricing, Nov 2026).
BRAVE_COST_PER_1K=5
BRAVE_MONTHLY_CREDIT_USD=5
# Minimum seconds between quota probes, however often Refresh is pressed.
BRAVE_QUOTA_MIN_INTERVAL_SECONDS=60
# Set to false to skip the probe at container start (saves one query per restart).
BRAVE_PROBE_ON_STARTUP=true
# auto: probe while WEB_SEARCH_PROVIDER=brave; otherwise only on an explicit
#       "Probe quota" click (POST /api/refresh?probe=brave).
# true: probe on every startup/manual refresh. false: never probe.
# Auto refreshes (below) never probe, in any mode.
BRAVE_QUOTA_PROBE=auto

# --- auto refresh ---
# Seconds between server-side refreshes; open tabs re-fetch on the same
# interval. 0 disables; otherwise an integer >= 30.
AUTO_REFRESH_SECONDS=300

# --- Claude plan limits (estimate) ---
# Anthropic publishes no numbers for subscription limits, so calibrate these
# against Claude Code's /usage: limit = used shown here / (percent in /usage / 100).
# Metric: usd (API-equivalent cost, default; cache reads dominate raw tokens) or tokens.
CLAUDE_QUOTA_METRIC=usd
# 5-hour session and weekly limits for the chosen metric. Empty = not set.
CLAUDE_SESSION_LIMIT_USD=
CLAUDE_WEEKLY_LIMIT_USD=
CLAUDE_SESSION_LIMIT_TOKENS=
CLAUDE_WEEKLY_LIMIT_TOKENS=
# "rolling" (trailing 7 days) or a weekly reset in DASHBOARD_TIME_ZONE, e.g. "mon 00:00".
CLAUDE_WEEKLY_RESET=rolling
