# Copy to usage-dashboard.env and fill in. usage-dashboard.env is gitignored.
# Docker Compose reads interpolation values (HOST_PORT, BIND_ADDRESS,
# CLAUDE_PROJECTS_DIR) from .env, so symlink it: ln -s usage-dashboard.env .env

# --- host/compose settings ---
# Host interface the port is published on. 0.0.0.0 exposes it to the LAN.
BIND_ADDRESS=127.0.0.1
HOST_PORT=8787
# Host path to Claude Code transcripts (mounted read-only).
CLAUDE_PROJECTS_DIR=/path/to/home/.claude/projects

# --- app settings ---
# IANA time zone used for daily/monthly buckets.
DASHBOARD_TIME_ZONE=UTC

# Optional: Anthropic Admin API key (sk-ant-admin01-...) for real org usage/cost.
ANTHROPIC_ADMIN_KEY=

# Brave Search API key, used only for the quota-header probe (1 query per refresh).
BRAVE_API_KEY=your-brave-api-key
# USD per 1,000 requests and monthly free credit (Brave pricing, Nov 2026).
BRAVE_COST_PER_1K=5
BRAVE_MONTHLY_CREDIT_USD=5
# Minimum seconds between quota probes, however often Refresh is pressed.
BRAVE_QUOTA_MIN_INTERVAL_SECONDS=60
# Set to false to skip the probe at container start (saves one query per restart).
BRAVE_PROBE_ON_STARTUP=true
